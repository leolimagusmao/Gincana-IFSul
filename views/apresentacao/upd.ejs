<%- include('../cabecalho')%>

    <div>
        <tr><a href="/apresentacao"> ← Voltar </a></tr>
        <h3>Editar apresentação</h3>

        <form method="post">
            <p>ID: </p>
            <input type="text" name="id" value="<%=apresentacoes.id%>" readonly>
            <br><br>
            <p>Equipe</p>
            <select name="equipe" value="<%=apresentacoes.equipe%>">
                <option value="Inválido">Selecione...</option>
                <option value="Trojan">Trojan</option>
                <option value="Kitsune">Kitsune</option>
                <option value="País das Maravilhas">País das Maravilhas</option>
                <option value="Infolinos">Infolinos</option>
                <option value="Krakens">Krakens</option>
            </select>

            <p>Modalidade</p>
            <select name="modalidade" value="<%=apresentacoes.modalidade%>">
                <option value="Inválido">Selecione...</option>
                <option value="Dança">Dança</option>
                <option value="Música">Música</option>
                <option value="Teatro">Teatro</option>
            </select>

            <p>Duração</p>
            <input type="number" placeholder="Duração da apresentação..." name="duracao"
                value="<%=apresentacoes.duracao%>">
            <p>Resumo</p>
            <textarea placeholder="Resumo da apresentação..." name="resumo"
                value="<%=apresentacoes.resumo%>"></textarea>
            <p>Participantes</p>
            <input type="number" placeholder="Quantidade de participantes na apresentação..." name="participantes"
                value="<%=apresentacoes.participantes%>">
            <br><br>

            <button type="submit">Atualizar</button>
            <button type="reset">Cancelar</button>

        </form>

    </div>
    </body>

    </html>