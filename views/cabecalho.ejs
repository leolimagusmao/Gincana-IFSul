<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gincana IFSUL</title>
    <style>
    :root {
        color-scheme: dark;
        --bg: #111016;
        --surface: #1b1822;
        --surface-2: #24202d;
        --border: #393142;
        --text: #f2edf5;
        --muted: #b8adbf;
        --purple: #a78bfa;
        --magenta: #e879c5;
        --gold: #e7bd70;
        --wine: #8f3d68;
        --danger: #f07886;
        --shadow: 0 18px 45px rgba(0, 0, 0, .28);
    }

    * { box-sizing: border-box; }

    html { min-height: 100%; background: var(--bg); }

    body {
        min-height: 100vh;
        margin: 0;
        padding: 42px clamp(18px, 5vw, 76px) 32px;
        color: var(--text);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.6;
        background:
            radial-gradient(ellipse at 12% 0%, rgba(143, 61, 104, .22), transparent 34rem),
            radial-gradient(ellipse at 92% 12%, rgba(115, 83, 177, .18), transparent 32rem),
            linear-gradient(145deg, #111016 0%, #17131d 55%, #121019 100%);
    }

    body > h3 {
        max-width: 1200px;
        margin: 0 auto 22px;
        color: var(--text);
        font-size: clamp(1.45rem, 3vw, 2.15rem);
        font-weight: 750;
        letter-spacing: -.045em;
    }

    body > h3::before {
        content: "✦";
        margin-right: 12px;
        color: var(--gold);
        text-shadow: 0 0 18px rgba(231, 189, 112, .35);
    }

    /* Navegação principal */
    body > table {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        max-width: 1200px;
        margin: 0 auto 34px;
        border: 0;
    }

    body > table tr { display: contents; }

    body > table a {
        display: inline-flex;
        align-items: center;
        padding: 10px 17px;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--muted);
        background: rgba(36, 32, 45, .78);
        text-decoration: none;
        font-size: .94rem;
        font-weight: 650;
        transition: .2s ease;
    }

    body > table a:hover {
        color: #fff;
        border-color: rgba(167, 139, 250, .7);
        background: rgba(110, 78, 155, .28);
        transform: translateY(-2px);
    }

    body > div {
        width: min(100%, 1200px);
        margin: 0 auto 28px;
        padding: clamp(22px, 4vw, 38px);
        border: 1px solid rgba(167, 139, 250, .16);
        border-radius: 22px;
        background: linear-gradient(145deg, rgba(31, 27, 39, .96), rgba(25, 22, 32, .96));
        box-shadow: var(--shadow);
        overflow-x: auto;
    }

    h3 {
        margin: 0 0 10px;
        color: var(--text);
        font-size: clamp(1.35rem, 2.5vw, 1.8rem);
        letter-spacing: -.035em;
    }

    p { margin: 17px 0 7px; color: var(--muted); font-weight: 600; }

    a {
        color: var(--purple);
        text-decoration: none;
        transition: color .18s ease, border-color .18s ease, background .18s ease;
    }
    a:hover { color: var(--magenta); }

    /* Links de ação e retorno */
    body > div > a[href*="/add"] {
        display: inline-flex;
        align-items: center;
        padding: 10px 16px;
        border: 1px solid rgba(231, 189, 112, .35);
        border-radius: 10px;
        color: #211a13;
        background: linear-gradient(135deg, #f0ce8a, #dba85c);
        font-weight: 750;
        box-shadow: 0 7px 20px rgba(219, 168, 92, .12);
    }
    body > div > a[href*="/add"]:hover { filter: brightness(1.08); transform: translateY(-1px); }
    body > div > a[href^="/"]:not([href*="/add"]),
    body > div > tr a { color: var(--gold); }

    form {
        margin: 16px 0 22px;
        padding: 20px;
        border: 1px solid rgba(255, 255, 255, .07);
        border-radius: 15px;
        background: rgba(13, 11, 18, .28);
    }

    input, select, textarea {
        width: 100%;
        max-width: 620px;
        min-height: 44px;
        padding: 11px 13px;
        border: 1px solid #494052;
        border-radius: 9px;
        outline: none;
        color: var(--text);
        background: #17141e;
        font: inherit;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }

    select { cursor: pointer; }
    textarea { min-height: 112px; resize: vertical; }
    input::placeholder, textarea::placeholder { color: #817789; }
    input:focus, select:focus, textarea:focus {
        border-color: var(--purple);
        background: #1c1825;
        box-shadow: 0 0 0 3px rgba(167, 139, 250, .14);
    }

    input[type="submit"], button {
        width: auto;
        min-width: 112px;
        min-height: 42px;
        margin: 5px 8px 0 0;
        padding: 10px 18px;
        border: 1px solid transparent;
        border-radius: 9px;
        color: #17121d;
        background: linear-gradient(135deg, var(--purple), #c084fc);
        font: inherit;
        font-weight: 750;
        cursor: pointer;
        transition: transform .18s ease, filter .18s ease, box-shadow .18s ease;
    }
    input[type="submit"]:hover, button:hover {
        filter: brightness(1.1);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(167, 139, 250, .18);
    }
    button[type="reset"] {
        color: var(--muted);
        border-color: var(--border);
        background: var(--surface-2);
        box-shadow: none;
    }

    /* Tabelas de registros */
    body > div table {
        width: 100%;
        min-width: 620px;
        margin-top: 18px;
        border: 1px solid var(--border);
        border-collapse: separate;
        border-spacing: 0;
        border-radius: 13px;
        overflow: hidden;
        background: rgba(15, 13, 20, .35);
    }
    body > div table tr:first-child { background: linear-gradient(90deg, rgba(143, 61, 104, .28), rgba(115, 83, 177, .22)); }
    body > div table td {
        padding: 13px 15px;
        border-bottom: 1px solid rgba(255, 255, 255, .07);
        color: #ded6e4;
        text-align: left;
        vertical-align: middle;
    }
    body > div table tr:first-child td { color: var(--gold); font-weight: 750; white-space: nowrap; }
    body > div table tr:not(:first-child):hover { background: rgba(167, 139, 250, .07); }
    body > div table tr:last-child td { border-bottom: 0; }
    body > div table td a { display: inline-block; padding: 4px 7px; }

    footer {
        width: min(100%, 1200px);
        margin: 38px auto 0;
        padding-top: 18px;
        border-top: 1px solid rgba(255, 255, 255, .08);
        color: #817789;
        text-align: center;
        font-size: .88rem;
    }

    @media (max-width: 640px) {
        body { padding: 26px 14px; }
        body > div { padding: 20px 15px; border-radius: 16px; }
        form { padding: 14px; }
        body > table { margin-bottom: 24px; }
        body > table a { padding: 9px 13px; }
    }
</style>
</head>

<body>
    <h3>Sistema de Gerenciamento da Gincana</h3>
    <table>
        <tr><a href="/apresentacao">Apresentação </a> | </tr>
        <tr><a href="/curta">Curta </a> | </tr>
        <tr><a href="/entrada">Entrada </a></tr>
    </table>